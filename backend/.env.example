# Copy this file to .env and fill in real values. .env is gitignored —
# never commit real credentials.

# Zoho Books OAuth (from https://api-console.zoho.com — a "Server-based
# Application" client). The refresh token is generated once via Zoho's
# OAuth consent flow and does not expire unless revoked.
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
ZOHO_ORGANIZATION_ID=
# Accounts/API base domain for your Zoho data center: .com (US) / .eu / .in / .com.au / .jp
ZOHO_ACCOUNTS_DOMAIN=https://accounts.zoho.com
ZOHO_API_DOMAIN=https://www.zohoapis.com

# Flask session cookie signing key — set to a long random string in production.
SECRET_KEY=dev-only-change-me

# Origin(s) the frontend is served from, comma-separated, for CORS.
FRONTEND_ORIGIN=http://localhost:8000
